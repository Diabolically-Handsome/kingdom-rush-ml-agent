# 可选配置：复制为同目录 deployment.env 后编辑。无需配置即可使用本地规则策略。
# 这是 KEY=VALUE 格式，不执行脚本，不支持在值后追加行内注释。
# 配置只作用于本次启动及子进程，不修改 Windows 全局环境。

KR_GAME_EXE=D:\SteamLibrary\steamapps\common\Kingdom Rush\Kingdom Rush.exe
KR_NO_LLM=1

# 使用 API 策略时，显式改为 KR_NO_LLM=0，并取消以下配置的注释、填写实际密钥。
# 不要公开 deployment.env、不要把密钥写入提交、截图或日志。
# KR_ARK_API_KEY=请填写您的密钥
# KR_MODEL=doubao-seed-2-0-lite-260215
# KR_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
